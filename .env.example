# =================================================================
# EthioDV-FillTrack Environment Configuration (.env)
# Copy this file to .env inside /api and fill in your values
# =================================================================

# Server & Client Ports
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5000

# =================================================================
# 1. DATABASE: MongoDB Atlas (Free M0 Shared Cluster)
# Get your URI at: https://cloud.mongodb.com
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ethiodv?retryWrites=true&w=majority
# =================================================================
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/ethiodv?retryWrites=true&w=majority

# =================================================================
# 2. SECURITY & SECRETS
# Generate a random 32-char string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# =================================================================
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
FLE_MASTER_KEY=your_32_byte_hex_field_level_encryption_key_here

# =================================================================
# 3. CLOUDFLARE R2 (Zero-Egress-Fee Private Storage for Photos & Receipts)
# Get from: Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
# NOTE: In local development, if left blank, our system automatically
# uses the built-in local mock storage fallback!
# =================================================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=ethiodv-documents

# =================================================================
# 4. TELEGRAM BOT (100% Free Transactional Alerts & Deep Linking)
# Create a free bot at: @BotFather on Telegram
# Get your Chat ID from: @userinfobot or @RawDataBot
# =================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=ethiodv_tg_secret_change_me

# =================================================================
# 5. TRANSACTIONAL EMAIL (Resend - Free 3,000 Emails/Month)
# Get your free API key at: https://resend.com
# =================================================================
RESEND_API_KEY=
FROM_EMAIL=EthioDV-FillTrack <onboarding@resend.dev>

# =================================================================
# 6. ANDROID COMPANION SMS FORWARDER (Optional)
# Secret header for the Telebirr 127 SMS companion listener
# =================================================================
SMS_WEBHOOK_SECRET=ethiodv_sms_secret_998877

# =================================================================
# 7. BUSINESS DEFAULTS
# =================================================================
DEFAULT_PRICE_ETB=1000
MAX_DAILY_ENTRIES=160
